datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum PlatformRole {
  SUPER_ADMIN
  RESTAURANT_USER
}

enum RestaurantRole {
  OWNER
  KITCHEN
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

enum TableStatus {
  ACTIVE
  INACTIVE
}

enum GuestSessionStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  PAY_AT_RESTAURANT
}

enum ItemAvailability {
  AVAILABLE
  SOLD_OUT
  UNAVAILABLE
}

enum TaxCalculationType {
  PERCENTAGE
  FIXED
}

// ----------------------------------------------------
// TENANT & RESTAURANT HIERARCHY
// ----------------------------------------------------

model Tenant {
  id        String       @id @default(uuid())
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  restaurants Restaurant[]

  @@map("tenants")
}

model Restaurant {
  id                     String           @id @default(uuid())
  tenantId               String           @map("tenant_id")
  name                   String
  slug                   String           @unique
  logoUrl                String?          @map("logo_url")
  status                 RestaurantStatus @default(ACTIVE)
  payAtRestaurantEnabled Boolean          @default(false) @map("pay_at_restaurant_enabled")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches       Branch[]
  memberships    RestaurantMembership[]
  subscriptions  RestaurantSubscription[]
  menuCategories MenuCategory[]
  modifierGroups ModifierGroup[]
  taxRules       TaxRule[]
  orders         CustomerOrder[]
  auditLogs      AuditLog[]

  @@index([tenantId])
  @@map("restaurants")
}

model Branch {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  name         String
  addressLine1 String?  @map("address_line1")
  city         String?
  state        String?
  pincode      String?
  timezone     String   @default("Asia/Kolkata")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables         DiningTable[]
  orders         CustomerOrder[]
  menuCategories MenuCategory[]
  taxRules       TaxRule[]

  @@index([restaurantId])
  @@map("branches")
}

// ----------------------------------------------------
// IDENTITY & MEMBERSHIPS
// ----------------------------------------------------

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String       @map("password_hash")
  displayName  String       @map("display_name")
  platformRole PlatformRole @default(RESTAURANT_USER) @map("platform_role")
  status       String       @default("ACTIVE")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  memberships   RestaurantMembership[]
  auditLogs     AuditLog[]
  statusUpdates OrderStatusHistory[]

  @@map("users")
}

model RestaurantMembership {
  id           String         @id @default(uuid())
  restaurantId String         @map("restaurant_id")
  userId       String         @map("user_id")
  role         RestaurantRole
  status       String         @default("ACTIVE")
  createdAt    DateTime       @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, userId])
  @@index([userId])
  @@map("restaurant_memberships")
}

// ----------------------------------------------------
// SUBSCRIPTIONS
// ----------------------------------------------------

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  price         Decimal  @db.Decimal(10, 2)
  billingPeriod String   @default("MONTHLY") @map("billing_period")
  featureConfig Json?    @map("feature_config")
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now()) @map("created_at")

  subscriptions RestaurantSubscription[]

  @@map("subscription_plans")
}

model RestaurantSubscription {
  id                String             @id @default(uuid())
  restaurantId      String             @map("restaurant_id")
  planId            String             @map("plan_id")
  status            SubscriptionStatus @default(ACTIVE)
  startsAt          DateTime           @map("starts_at")
  endsAt            DateTime?          @map("ends_at")
  providerReference String?            @map("provider_reference")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([restaurantId])
  @@index([status])
  @@map("restaurant_subscriptions")
}

// ----------------------------------------------------
// DINING TABLES & SECURE QR CODES
// ----------------------------------------------------

model DiningTable {
  id          String      @id @default(uuid())
  branchId    String      @map("branch_id")
  tableCode   String      @map("table_code")
  displayName String      @map("display_name")
  capacity    Int         @default(4)
  status      TableStatus @default(ACTIVE)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  qrTokens      QRToken[]
  guestSessions GuestSession[]
  orders        CustomerOrder[]

  @@unique([branchId, tableCode])
  @@index([branchId])
  @@map("dining_tables")
}

model QRToken {
  id            String    @id @default(uuid())
  diningTableId String    @map("dining_table_id")
  tokenHash     String    @unique @map("token_hash")
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now()) @map("created_at")
  expiresAt     DateTime? @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")

  diningTable   DiningTable    @relation(fields: [diningTableId], references: [id], onDelete: Cascade)
  guestSessions GuestSession[]

  @@index([diningTableId])
  @@map("qr_tokens")
}

// ----------------------------------------------------
// GUEST SESSIONS & CARTS
// ----------------------------------------------------

model GuestSession {
  id              String             @id @default(uuid())
  qrTokenId       String             @map("qr_token_id")
  diningTableId   String             @map("dining_table_id")
  accessTokenHash String             @unique @map("access_token_hash")
  customerName    String?            @map("customer_name")
  customerPhone   String?            @map("customer_phone")
  status          GuestSessionStatus @default(ACTIVE)
  startedAt       DateTime           @default(now()) @map("started_at")
  expiresAt       DateTime           @map("expires_at")

  qrToken     QRToken         @relation(fields: [qrTokenId], references: [id], onDelete: Restrict)
  diningTable DiningTable     @relation(fields: [diningTableId], references: [id], onDelete: Restrict)
  carts       Cart[]
  orders      CustomerOrder[]

  @@index([diningTableId])
  @@index([status])
  @@map("guest_sessions")
}

model Cart {
  id             String     @id @default(uuid())
  guestSessionId String     @map("guest_session_id")
  status         CartStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  guestSession GuestSession   @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  items        CartItem[]
  order        CustomerOrder?

  @@index([guestSessionId])
  @@map("carts")
}

model CartItem {
  id             String  @id @default(uuid())
  cartId         String  @map("cart_id")
  menuItemId     String  @map("menu_item_id")
  quantity       Int     @default(1)
  unitPriceAtAdd Decimal @map("unit_price_at_add") @db.Decimal(10, 2)
  notes          String?

  cart              Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem          MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  selectedModifiers CartItemModifier[]

  @@index([cartId])
  @@map("cart_items")
}

model CartItemModifier {
  id               String  @id @default(uuid())
  cartItemId       String  @map("cart_item_id")
  modifierOptionId String  @map("modifier_option_id")
  priceDeltaAtAdd  Decimal @map("price_delta_at_add") @db.Decimal(10, 2)

  cartItem       CartItem       @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)

  @@index([cartItemId])
  @@map("cart_item_modifiers")
}

// ----------------------------------------------------
// MENU & MODIFIERS
// ----------------------------------------------------

model MenuCategory {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  branchId     String?  @map("branch_id")
  name         String
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items      MenuItem[]

  @@index([restaurantId])
  @@map("menu_categories")
}

model MenuItem {
  id                 String           @id @default(uuid())
  categoryId         String           @map("category_id")
  name               String
  description        String?
  imageUrl           String?          @map("image_url")
  price              Decimal          @db.Decimal(10, 2)
  isVeg              Boolean          @default(false) @map("is_veg")
  availabilityStatus ItemAvailability @default(AVAILABLE) @map("availability_status")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  category       MenuCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifierGroups MenuItemModifierGroup[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([availabilityStatus])
  @@map("menu_items")
}

model ModifierGroup {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  name         String
  minSelect    Int      @default(0) @map("min_select")
  maxSelect    Int      @default(1) @map("max_select")
  isRequired   Boolean  @default(false) @map("is_required")
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  options    ModifierOption[]
  menuItems  MenuItemModifierGroup[]

  @@index([restaurantId])
  @@map("modifier_groups")
}

model MenuItemModifierGroup {
  menuItemId      String @map("menu_item_id")
  modifierGroupId String @map("modifier_group_id")
  sortOrder       Int    @default(0) @map("sort_order")

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, modifierGroupId])
  @@map("menu_item_modifier_groups")
}

model ModifierOption {
  id              String  @id @default(uuid())
  modifierGroupId String  @map("modifier_group_id")
  name            String
  priceDelta      Decimal @default(0.00) @map("price_delta") @db.Decimal(10, 2)
  isAvailable     Boolean @default(true) @map("is_available")
  sortOrder       Int     @default(0) @map("sort_order")

  modifierGroup ModifierGroup      @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  cartModifiers CartItemModifier[]

  @@index([modifierGroupId])
  @@map("modifier_options")
}

// ----------------------------------------------------
// TAXATION RULES
// ----------------------------------------------------

model TaxRule {
  id              String             @id @default(uuid())
  restaurantId    String             @map("restaurant_id")
  branchId        String?            @map("branch_id")
  name            String
  rate            Decimal            @db.Decimal(5, 2)
  calculationType TaxCalculationType @default(PERCENTAGE) @map("calculation_type")
  isActive        Boolean            @default(true) @map("is_active")
  effectiveFrom   DateTime           @default(now()) @map("effective_from")
  effectiveTo     DateTime?          @map("effective_to")

  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orderTaxLines OrderTaxLine[]

  @@index([restaurantId])
  @@map("tax_rules")
}

// ----------------------------------------------------
// ORDERS & FINANCIAL SNAPSHOTS
// ----------------------------------------------------

model CustomerOrder {
  id                   String      @id @default(uuid())
  restaurantId         String      @map("restaurant_id")
  branchId             String      @map("branch_id")
  diningTableId        String      @map("dining_table_id")
  guestSessionId       String      @map("guest_session_id")
  cartId               String?     @unique @map("cart_id")
  orderNumber          String      @unique @map("order_number")
  customerName         String      @map("customer_name")
  customerPhone        String      @map("customer_phone")
  status               OrderStatus @default(PENDING)
  subtotal             Decimal     @db.Decimal(10, 2)
  taxTotal             Decimal     @map("tax_total") @db.Decimal(10, 2)
  discountTotal        Decimal     @default(0.00) @map("discount_total") @db.Decimal(10, 2)
  grandTotal           Decimal     @map("grand_total") @db.Decimal(10, 2)
  estimatedPrepMinutes Int?        @map("estimated_prep_minutes")
  estimateUpdatedAt    DateTime?   @map("estimate_updated_at")
  notes                String?
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch        Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  diningTable   DiningTable          @relation(fields: [diningTableId], references: [id], onDelete: Restrict)
  guestSession  GuestSession         @relation(fields: [guestSessionId], references: [id], onDelete: Restrict)
  cart          Cart?                @relation(fields: [cartId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  taxLines      OrderTaxLine[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]

  @@index([restaurantId])
  @@index([branchId])
  @@index([diningTableId])
  @@index([guestSessionId])
  @@index([status])
  @@index([createdAt])
  @@map("customer_orders")
}

model OrderItem {
  id               String  @id @default(uuid())
  orderId          String  @map("order_id")
  menuItemId       String? @map("menu_item_id")
  itemNameSnapshot String  @map("item_name_snapshot")
  quantity         Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(10, 2)
  lineTotal        Decimal @map("line_total") @db.Decimal(10, 2)

  order     CustomerOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem  MenuItem?           @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id                   String  @id @default(uuid())
  orderItemId          String  @map("order_item_id")
  modifierNameSnapshot String  @map("modifier_name_snapshot")
  optionNameSnapshot   String  @map("option_name_snapshot")
  priceDelta           Decimal @map("price_delta") @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

model OrderTaxLine {
  id              String  @id @default(uuid())
  orderId         String  @map("order_id")
  taxRuleId       String? @map("tax_rule_id")
  taxNameSnapshot String  @map("tax_name_snapshot")
  rateSnapshot    Decimal @map("rate_snapshot") @db.Decimal(5, 2)
  taxableAmount   Decimal @map("taxable_amount") @db.Decimal(10, 2)
  taxAmount       Decimal @map("tax_amount") @db.Decimal(10, 2)

  order   CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  taxRule TaxRule?      @relation(fields: [taxRuleId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_tax_lines")
}

model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String       @map("order_id")
  fromStatus      OrderStatus? @map("from_status")
  toStatus        OrderStatus  @map("to_status")
  changedByUserId String?      @map("changed_by_user_id")
  reason          String?
  createdAt       DateTime     @default(now()) @map("created_at")

  order         CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User?         @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_status_history")
}

// ----------------------------------------------------
// PAYMENTS & WEBHOOK IDEMPOTENCY
// ----------------------------------------------------

model Payment {
  id                 String        @id @default(uuid())
  orderId            String        @map("order_id")
  provider           String        @default("RAZORPAY")
  method             PaymentMethod @default(ONLINE)
  status             PaymentStatus @default(INITIATED)
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("INR")
  providerOrderRef   String?       @map("provider_order_ref")
  providerPaymentRef String?       @map("provider_payment_ref")
  idempotencyKey     String        @unique @map("idempotency_key")
  createdAt          DateTime      @default(now()) @map("created_at")
  verifiedAt         DateTime?     @map("verified_at")

  order         CustomerOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  webhookEvents PaymentWebhookEvent[]

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model PaymentWebhookEvent {
  id                String    @id @default(uuid())
  paymentId         String?   @map("payment_id")
  providerEventId   String    @unique @map("provider_event_id")
  eventType         String    @map("event_type")
  signatureVerified Boolean   @default(false) @map("signature_verified")
  payloadReference  Json?     @map("payload_reference")
  receivedAt        DateTime  @default(now()) @map("received_at")
  processedAt       DateTime? @map("processed_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@map("payment_webhook_events")
}

// ----------------------------------------------------
// AUDIT LOGGING
// ----------------------------------------------------

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?  @map("actor_user_id")
  restaurantId String?  @map("restaurant_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  actorUser  User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([actorUserId])
  @@map("audit_logs")
}
